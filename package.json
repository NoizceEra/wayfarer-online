{
  "name": "wayfarer-online",
  "version": "0.1.0",
  "description": "Wayfarer Online — a cozy Game Boy-style open-world action RPG with modular characters and solo/co-op interop.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port 5176 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5177 --strictPort",
    "start": "node server/index.js",
    "postinstall": "npm ci --prefix server",
    "copy-assets": "node tools/copy_assets.mjs"
  },
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "colyseus.js": "^0.16.22",
    "phaser": "^3.90.0",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  }
}
