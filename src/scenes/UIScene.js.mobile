/**
 * UIScene.js — Mobile-only overlay scene for Wayfarer Online.
 * Adds a virtual joystick, action buttons, chat toggle, and orientation hint.
 * Does not alter desktop gameplay.
 */

import Phaser from 'phaser';
import { MobileInput, isMobile } from '../core/input.js';
import { SocialDom } from '../ui/socialDom.js';

export default class UIScene extends Phaser.Scene {
  constructor() {
    super({ key: 'UIScene' });
  }

  create() {
    this.mobile = isMobile();
    if (!this.mobile) {
      // Keep scene alive but invisible on desktop
      return;
    }

    this.W = this.cameras.main.width;
    this.H = this.cameras.main.height;
    this.socialDom = new SocialDom();
    this.socialDom.hide();

    this.mobileInput = new MobileInput(this);
    this.mobileInput.createJoystick(110, this.H - 110, 72);
    this.mobileInput.createActionButtons({ x: this.W - 90, y: this.H - 110, size: 72, gap: 86 });
    this.mobileInput.onAction = (action) => this.handleAction(action);

    this.createChatToggle();
    this.createOrientationHint();

    window.addEventListener('resize', () => this.onResize());
    window.addEventListener('orientationchange', () => this.onResize());
  }

  update() {
    if (!this.mobile) return;
    const gameScene = this.scene.get('GameScene');
    if (!gameScene || !gameScene.player) return;

    const v = this.mobileInput.getVector();
    const speed = 4;
    if (v.x !== 0 || v.y !== 0) {
      gameScene.player.x += v.x * speed;
      gameScene.player.y += v.y * speed;
      gameScene.player.x = Phaser.Math.Clamp(gameScene.player.x, 12, 948);
      gameScene.player.y = Phaser.Math.Clamp(gameScene.player.y, 12, 628);
    }

    if (this.mobileInput.consumeJustPressed('dodge')) {
      this.dodgePlayer(gameScene.player, v);
    }
  }

  handleAction(action) {
    if (action === 'interact') {
      this.showToast('Interact pressed');
    } else if (action === 'attack') {
      this.flashAction('attack');
    }
    // Dodge is handled in update so it can use the current movement direction.
  }

  dodgePlayer(player, direction) {
    const dash = 60;
    const dx = direction.x || 1;
    const dy = direction.y || 0;
    const len = Math.sqrt(dx * dx + dy * dy) || 1;
    const nx = dx / len;
    const ny = dy / len;
    const targetX = Phaser.Math.Clamp(player.x + nx * dash, 12, 948);
    const targetY = Phaser.Math.Clamp(player.y + ny * dash, 12, 628);
    this.tweens.add({
      targets: player,
      x: targetX,
      y: targetY,
      duration: 180,
      ease: 'Power2',
    });
  }

  createChatToggle() {
    this.chatBtn = this.add.container(28, 28).setScrollFactor(0).setDepth(1004);
    const bg = this.add.rectangle(0, 0, 56, 56, 0x161b22, 0.85)
      .setStrokeStyle(2, 0x9945ff, 0.7);
    const icon = this.add.text(0, 0, '💬', { fontSize: '24px' }).setOrigin(0.5);
    this.chatBtn.add([bg, icon]);

    const hit = this.add.zone(0, 0, 72, 72)
      .setScrollFactor(0)
      .setDepth(1005)
      .setInteractive({ useHandCursor: true });
    this.chatBtn.add(hit);

    hit.on('pointerdown', () => {
      this.socialDom.toggle();
      bg.setFillStyle(0x14f195, 0.35);
    });
    hit.on('pointerup', () => bg.setFillStyle(0x161b22, 0.85));
    hit.on('pointerout', () => bg.setFillStyle(0x161b22, 0.85));
  }

  createOrientationHint() {
    if (this.scale.orientation !== Phaser.Scale.Orientation.PORTRAIT) return;
    this.orientationHint = this.add.container(this.W / 2, this.H / 2).setDepth(2000);
    const bg = this.add.rectangle(0, 0, 320, 120, 0x0b0d14, 0.95)
      .setStrokeStyle(2, 0x14f195, 0.8);
    const text = this.add.text(0, 0, '📱 Rotate to landscape for best play', {
      fontFamily: '"Courier New", monospace',
      fontSize: '16px',
      color: '#e8e8e8',
      align: 'center',
    }).setOrigin(0.5);
    this.orientationHint.add([bg, text]);
  }

  onResize() {
    if (!this.orientationHint) return;
    if (this.scale.orientation === Phaser.Scale.Orientation.PORTRAIT) {
      this.orientationHint.setVisible(true);
    } else {
      this.orientationHint.setVisible(false);
    }
  }

  showToast(message) {
    const toast = this.add.text(this.W / 2, this.H / 2 - 80, message, {
      fontFamily: '"Courier New", monospace',
      fontSize: '14px',
      color: '#14f195',
      fontStyle: 'bold',
    }).setOrigin(0.5).setDepth(3000);
    this.tweens.add({
      targets: toast,
      y: toast.y - 40,
      alpha: 0,
      duration: 1500,
      onComplete: () => toast.destroy(),
    });
  }

  flashAction(action) {
    const btn = this.mobileInput.actionButtons[action];
    if (!btn) return;
    this.tweens.add({
      targets: btn.bg,
      alpha: 0.4,
      duration: 80,
      yoyo: true,
    });
  }
}
