/**
 * socialDom.js — DOM-based social / chat panel with large mobile touch targets.
 * Rendered above the canvas only on mobile; no desktop gameplay changes.
 */

const CSS_ID = 'wayfarer-social-styles';

function injectStyles() {
  if (typeof document === 'undefined' || document.getElementById(CSS_ID)) return;
  const style = document.createElement('style');
  style.id = CSS_ID;
  style.textContent = `
    #wayfarer-social-panel {
      position: fixed;
      top: 88px;
      left: 12px;
      right: 12px;
      max-width: 420px;
      bottom: 12px;
      background: rgba(11, 13, 20, 0.95);
      border: 2px solid #9945ff;
      border-radius: 8px;
      color: #e8e8e8;
      font-family: "Courier New", Courier, monospace;
      display: flex;
      flex-direction: column;
      z-index: 10000;
      box-shadow: 0 0 20px rgba(153, 69, 255, 0.3);
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }
    #wayfarer-social-panel.hidden { display: none !important; }
    #wayfarer-social-panel .social-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid rgba(153, 69, 255, 0.4);
      background: rgba(22, 27, 34, 0.85);
    }
    #wayfarer-social-panel .social-title {
      font-size: 16px;
      font-weight: bold;
      color: #14f195;
    }
    #wayfarer-social-panel .social-close {
      width: 44px;
      height: 44px;
      font-size: 22px;
      line-height: 44px;
      text-align: center;
      color: #dc1fff;
      background: rgba(153, 69, 255, 0.15);
      border: 1px solid rgba(153, 69, 255, 0.5);
      border-radius: 6px;
      cursor: pointer;
    }
    #wayfarer-social-panel .social-messages {
      flex: 1;
      overflow-y: auto;
      padding: 12px;
      font-size: 14px;
      line-height: 1.5;
    }
    #wayfarer-social-panel .social-message {
      margin-bottom: 12px;
      padding: 10px 12px;
      background: rgba(22, 27, 34, 0.7);
      border-left: 3px solid #03e1ff;
      border-radius: 4px;
      min-height: 44px;
    }
    #wayfarer-social-panel .social-author {
      color: #14f195;
      font-weight: bold;
      margin-right: 8px;
    }
    #wayfarer-social-panel .social-input-row {
      display: flex;
      gap: 10px;
      padding: 12px;
      border-top: 1px solid rgba(153, 69, 255, 0.4);
    }
    #wayfarer-social-panel .social-input {
      flex: 1;
      min-height: 52px;
      padding: 12px 14px;
      font-size: 16px; /* prevents iOS zoom */
      border: 1px solid #9945ff;
      border-radius: 6px;
      background: #161b22;
      color: #e8e8e8;
      font-family: inherit;
    }
    #wayfarer-social-panel .social-send {
      min-width: 84px;
      min-height: 52px;
      font-size: 16px;
      font-weight: bold;
      color: #0b0d14;
      background: #14f195;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    /* Larger touch targets on small screens */
    @media (max-width: 640px) {
      #wayfarer-social-panel { top: 72px; left: 6px; right: 6px; bottom: 6px; }
      #wayfarer-social-panel .social-close { width: 52px; height: 52px; line-height: 52px; }
      #wayfarer-social-panel .social-message { padding: 14px; }
      #wayfarer-social-panel .social-send { min-width: 96px; min-height: 56px; }
      #wayfarer-social-panel .social-input { min-height: 56px; }
    }
  `;
  document.head.appendChild(style);
}

export class SocialDom {
  constructor() {
    injectStyles();
    this.panel = document.createElement('div');
    this.panel.id = 'wayfarer-social-panel';
    this.panel.className = 'hidden';
    this.panel.innerHTML = `
      <div class="social-header">
        <span class="social-title">CHAT</span>
        <div class="social-close" role="button" aria-label="Close chat">✕</div>
      </div>
      <div class="social-messages"></div>
      <div class="social-input-row">
        <input class="social-input" type="text" maxlength="140" placeholder="Say something..." aria-label="Chat message" />
        <button class="social-send" type="button">SEND</button>
      </div>
    `;
    document.body.appendChild(this.panel);

    this.messagesEl = this.panel.querySelector('.social-messages');
    this.inputEl = this.panel.querySelector('.social-input');
    this.closeEl = this.panel.querySelector('.social-close');
    this.sendEl = this.panel.querySelector('.social-send');

    this.closeEl.addEventListener('click', () => this.hide());
    this.sendEl.addEventListener('click', () => this.submit());
    this.inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') this.submit();
    });
  }

  show() {
    this.panel.classList.remove('hidden');
  }

  hide() {
    this.panel.classList.add('hidden');
  }

  toggle() {
    this.panel.classList.toggle('hidden');
  }

  addMessage(author, text) {
    const row = document.createElement('div');
    row.className = 'social-message';
    row.innerHTML = `<span class="social-author">${this.escape(author)}:</span>${this.escape(text)}`;
    this.messagesEl.appendChild(row);
    this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
  }

  submit() {
    const text = this.inputEl.value.trim();
    if (!text) return;
    if (this.onSubmit) this.onSubmit(text);
    this.inputEl.value = '';
  }

  escape(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  destroy() {
    this.panel.remove();
    const style = document.getElementById(CSS_ID);
    if (style) style.remove();
  }
}

export default SocialDom;
