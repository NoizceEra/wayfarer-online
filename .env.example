VITE_SERVER_URL=ws://localhost:2567

# ─── Wayfarer Online — environment placeholders ────────────────────────────
# Copy to `.env` (never commit the real file) and fill in real values.
# ALL bridge variables are OPTIONAL: when they are unset the token bridge
# degrades honestly — withdrawals return status "unconfigured" and nothing is
# deducted from the player (see docs/BLOCKCHAIN_ARCH.md, "Token bridge").

# ─── Server relay ──────────────────────────────────────────────────────────
PORT=2567
# Use the SQLite store. REQUIRED for wallet linking and the bridge ledgers
# (the `wallets`, `bridge_withdrawals`, `bridge_deposits` tables live there).
USE_SQLITE=1
DATA_DIR=./server/data
LOG_LEVEL=info

# ─── Solana token bridge (devnet) ──────────────────────────────────────────
# Network label shown in the bridge panel (devnet | mainnet-beta).
SOLANA_NETWORK=devnet
# RPC endpoint the server uses to verify deposits and send mints.
SOLANA_RPC=https://api.devnet.solana.com
# programs/wayfarer_token declare_id!() — the deployed bridge program.
PROGRAM_ID=
# $WAYFARER SPL mint address.
MINT_ADDRESS=
# Treasury ATA that receives deposits. Optional: when empty the server derives
# it as the ATA of the bridge config PDA (requires PROGRAM_ID).
TREASURY_ADDRESS=
# JSON secret-key array (the [12,34,...] form from `solana-keygen`) of the
# oracle wallet that signs mint_withdraw. NEVER commit a real value.
ORACLE_KEYPAIR=
# SPL decimals of $WAYFARER (0-9).
TOKEN_DECIMALS=6
